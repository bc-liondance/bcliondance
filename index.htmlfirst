                    <iframe 
                        src="https://calendar.google.com/calendar/embed?src=en.usa%23holiday%40group.v.calendar.google.com&ctz=America%2FNew_York" 
                        style="border: 0" 
                        width="100%" 
                        height="550" 
                        frameborder="0" 
                        scrolling="no"
                        title="Boston College Lion Dance Calendar">
                    </iframe>
                </div>
            </div>
        </div>
    </section>

    <!-- Join Us Section (NEU Banner Format) -->
    <section id="join" class="py-16 bg-bcMaroon text-white border-b border-bcGold">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
