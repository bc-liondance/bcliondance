    <!-- Book a Performance Section (NEU Logistics Layout) -->
    <section id="booking" class="py-20 bg-gradient-to-br from-bcMaroon via-darkRed to-black text-white border-b-4 border-bcGold">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-12 gap-12 items-center">
                
                <div class="lg:col-span-7">
                    <h2 class="font-heading text-3xl sm:text-5xl font-bold mb-6 leading-tight">Book a Performance for Your Event</h2>

                    <p class="text-gray-200 text-base sm:text-lg mb-8 leading-relaxed">
                        If you are looking to book us, please fill out the booking request form linked below! After reviewing your request, we will get back to you with our availability and discuss additional details and logistics.
                    </p>

                    <!-- Booking Form Button -->
                    <div>
                        <a href="https://forms.google.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-bcGold text-bcMaroon px-8 py-4 rounded-xl font-bold text-lg hover:bg-white hover:text-bcMaroon transition-all shadow-2xl gap-3">
                            <i class="fa-solid fa-paper-plane"></i> Fill Out Booking Request Form
                        </a>
                        <p class="text-xs text-gray-300 mt-2">Links directly to our official Google Request Form.</p>
                    </div>
                </div>

                <!-- Contact & Questions Box -->
                <div class="lg:col-span-5 bg-white text-gray-900 rounded-2xl p-8 shadow-2xl border-2 border-bcGold">
                    <h3 class="font-heading text-2xl font-bold text-bcMaroon mb-2">Have Questions?</h3>
                    <p class="text-xs text-gray-600 mb-6">Reach out to us directly for custom inquiries or scheduling.</p>

                    <div class="space-y-5">
                        <a href="mailto:liondance@bc.edu" class="flex items-center gap-4 p-3 rounded-xl bg-bcCream hover:bg-bcGold/20 transition-colors border border-gray-200">
                            <div class="w-10 h-10 rounded-full bg-bcMaroon text-bcGold flex items-center justify-center text-lg shrink-0">
                                <i class="fa-solid fa-envelope"></i>
                            </div>
                            <div>
                                <span class="block text-xs text-gray-500 uppercase font-bold">Email Us</span>
                                <span class="text-sm font-semibold text-gray-900">liondance@bc.edu</span>
                            </div>
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Practices & Google Calendar Section -->
    <section id="calendar" class="py-20 bg-white border-b border-gray-200">
